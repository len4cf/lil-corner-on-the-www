---
import { cn } from '@sglara/cn';
import '../styles/global.css';

interface Props {
  title?: string;
  bare?: boolean;
  page?: boolean;
}

const { title = 'Digital Garden', bare = false, page = false } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		{bare ? (
			<slot />
		) : (
			<div class={cn(
        "relative  h-full ",
        page && "min-h-screen px-5 pt-20 md:px-10 lg:p-16 xl:p-30",
      )}>
				<slot />
			</div>
		)}
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
    background-color: var(--bg-color-secondary);
		line-height: 1;
	}
</style>
