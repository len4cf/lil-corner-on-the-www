---

interface Props {
  name?: string;
  description?: string;
  href: string;
}

const { name, description, href } = Astro.props as Props;

---


<a
class="flex flex-col gap-2 p-4 w-auto lg:w-[50%] border border-[#73976A] rounded-lg hover:bg-[#73976A] hover:text-white transition-colors"
href={href}
target="_blank"
rel="noopener noreferrer">
  <h2 class="font-velve text-[24px]">{href}</h2>
  <p class="font-baskervville text-[16px]">{description}</p>
</a>