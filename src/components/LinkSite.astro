---

interface Props {
  name?: string;
  description?: string;
  href: string;
}

const { name, description, href } = Astro.props as Props;

---

<a
class="flex flex-col gap-2 p-4"
href={href}
target="_blank"
rel="noopener noreferrer">
  <h2 class="font-velve text-[18px] underline">{href}</h2>
  <blockquote class="text-[16px]!">{description}</blockquote>
</a>
