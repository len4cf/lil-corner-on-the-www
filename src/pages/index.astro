<PageLayout title="home">
  <pre class="overflow-x-auto font-bold leading-none" aria-hidden="true">
          )
         ( _   _._
          |_|-'_~_`-._
       _.-'-_~_-~_-~-_`-._
   _.-'_~-_~-_-~-_~_~-_~-_`-._
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
